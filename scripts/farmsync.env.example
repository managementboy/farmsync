# Copy to scripts/farmsync.env and adjust. farmsync.env is git-ignored.

# Wireless-debugging IPs of the devices (give them fixed IPs in your router).
PHONE_IP=192.168.1.20
TABLET_IP=192.168.1.21

# Optional: if the devices are reached through a VPN/mesh with a smaller MTU,
# set the remote subnet, gateway and local interface to get a route hint.
ROUTE_SUBNET=
ROUTE_GATEWAY=
ROUTE_DEV=

# Real farm folders that verify-real-farms.sh must find unchanged (space separated).
REAL_FARMS="MyFarm_123456789"

# Checksum file of the backup that verify-real-farms.sh compares against.
BASELINE=backups/phone/2026-01-01_120000/checksums.md5
